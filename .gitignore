# dependencies
node_modules/
.pnpm-store/

# build / tooling output
dist/
build/
*.tsbuildinfo
.turbo/

# 本地复现台的探针与截图
# .tmp/novel-studio-scratch/ 是桌面版仓库 novel-studio 的验证临时产物（fixture/断言现场/诊断脚本）的寄存处
# —— 由 novel-studio 迁入，避免占用桌面仓库空间；它随 .tmp/ 一并忽略
.tmp/
.tmp-*/
.tmp-*

# 前端工程的依赖（目录联接或本地安装，不进库）
app/node_modules/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# env & secrets
.env
.env.*
!.env.example

# 宣传片制作现场（showcase/）：成品体积以 GB 计，自带独立的 .git，
# 在插件仓库内只作本地存放，不进本库
showcase/

# 工具会话状态与扫描缓存
.mimosa/
.mimosa-cache/
.zcode/
.superpowers/

# editor / OS
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
