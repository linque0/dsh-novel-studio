{
  "name": "dsh-novel-studio",
  "version": "0.2.8",
  "description": "小说工坊 DSH 插件版：把作品库接进 DSH，由 DSH Agent 代替恍然梦做建议、审稿与编辑。",
  "icon": "./src/client/assets/plugin-icon.png",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./core": "./src/core/library.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "assets",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <5",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.5 <4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "build:app": "node app/node_modules/vite/bin/vite.js build --config app/vite.config.mjs",
    "link:app-deps": "node scripts/link-app-deps.mjs",
    "verify:app": "node scripts/verify-app.mjs",
    "compare:settings": "node scripts/compare-settings.mjs",
    "test:lore-layout": "node scripts/lore-layout.test.mjs",
    "test:char-layout": "node scripts/char-layout.test.mjs",
    "test:settings": "node scripts/settings-prefs.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "copy-app": "node scripts/copy-app.mjs",
    "copy-plugin-app": "node scripts/copy-plugin-app.mjs",
    "contract": "node scripts/host-contract.mjs && node scripts/client-contract.mjs",
    "preview": "node scripts/preview.mjs",
    "import-desktop": "node scripts/import-from-desktop.mjs"
  },
  "license": "MIT",
  "private": true
}
